# ==============================================================================
# Streamlit Community Cloud Secrets Template
# ==============================================================================
# When deploying to Streamlit Community Cloud (https://share.streamlit.io):
# Go to App Settings -> Secrets, and paste the values below:

MYSQL_HOST = "your-rds-endpoint.amazonaws.com"
MYSQL_PORT = 3306
MYSQL_DATABASE = "blood_bank"
MYSQL_USER = "your_username"
MYSQL_PASSWORD = "your_password"
